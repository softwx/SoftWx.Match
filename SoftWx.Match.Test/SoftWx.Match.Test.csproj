<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <DefineConstants Condition="'$(TestNetStandard)' == 'true'">$(DefineConstants);TEST_NETSTANDARD</DefineConstants>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SoftWx.Match\SoftWx.Match.csproj"
                      Condition="'$(TestNetStandard)' != 'true'" />
    <ProjectReference Include="..\SoftWx.Match\SoftWx.Match.csproj"
                      Condition="'$(TestNetStandard)' == 'true'"
                      SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

</Project>